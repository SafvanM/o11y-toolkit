# Copy to .env and fill in. Never commit .env.
SFX_REALM=eu0
SFX_TOKEN=paste-your-api-token-here
# Use a label containing PROD for production: forces typed confirmation, --yes is ignored
SFX_ORG_LABEL=TEST
OPERATOR=

# Detectors that must never be changed by this tool (comma-separated)
EXCLUDE_TAGS=terraform
EXCLUDE_NAME_PREFIXES=

# Optional overrides
# SFX_API_URL=https://api.eu0.observability.splunkcloud.com/v2
# READ_ONLY_FIELDS=id,created,creator,lastUpdated,lastUpdatedBy,overMTSLimit,labelResolutions,detectorOrigin,status
# PAGE_SIZE=100
# HTTP_TIMEOUT=30
# MAX_RETRIES=5
